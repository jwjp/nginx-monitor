# Required. Slack Incoming Webhook. Never commit a real value.
SLACK_WEBHOOK_URL=

# Local open-source NGINX stub_status page.
STATUS_URL=http://127.0.0.1/nginx_status
# Optional extra stub_status URLs, comma-separated.
STATUS_URLS=
# Keep false. Set true only when a status URL is intentionally not loopback.
ALLOW_REMOTE_STATUS=false
# Timeouts must be above 0 and at most 2147483647, or the default is used.
STATUS_TIMEOUT_MS=5000

# Five-field node-cron schedule. A seconds field is rejected. Default: every minute, all day, UTC.
CRON_SCHEDULE=* * * * *
CRON_TIMEZONE=UTC
# A cycle that starts while the previous one is still running is skipped.
# The next completed cycle alerts when the skipped count reaches this minimum. 0 disables.
SKIPPED_CYCLES_MIN=1

# Absolute connection counts. 0 disables the alert.
# Set these from worker_processes * worker_connections, not from a guess in git.
ACTIVE_CONNECTIONS_THRESHOLD=0
WAITING_CONNECTIONS_THRESHOLD=0
READING_CONNECTIONS_THRESHOLD=0
WRITING_CONNECTIONS_THRESHOLD=0
# Alert when accepted-minus-handled in one interval reaches this count. 0 disables.
DROPPED_CONNECTIONS_MIN=1
# The monitor's own polls to the same origin, and a probe to that origin, do not count as traffic.
# A quiet site still looks stalled, so leave this off unless the site is always busy.
REQUEST_STALL_ENABLED=false
REQUEST_STALL_WINDOWS=5

# Optional request sent through NGINX. Empty disables it.
PROBE_URL=
PROBE_TIMEOUT_MS=5000
ALLOW_REMOTE_PROBE=false
# Single status, comma-separated statuses, or an inclusive range such as 200-399.
# A redirect is a failure even when its status is inside that range.
PROBE_ACCEPTED_STATUSES=200-399

# Optional, off by default so the process does not need root.
NGINX_TEST_ENABLED=false
NGINX_BIN=nginx
NGINX_PID_FILE=

# Repeat alerts for a condition that is still true. Recovery clears the timer.
THROTTLE_DURATION_MS=900000
# Good samples in a row before a status or probe condition recovers, so a value
# flapping around a threshold does not post an alert and a recovery every cycle.
RECOVER_AFTER_SAMPLES=3
# A failed incident post is retried next cycle with its original time.
# A condition that is still true replaces that copy. A failed recovery is not queued.
# Restarts are kept separately, up to 10 per target. One failure defers the rest of that cycle.
SLACK_TIMEOUT_MS=10000
RUN_ONCE=false

# Loopback JSON history. Port 3032 stays clear of pm2-monitor on 3031.
WEB_ENABLED=true
HOST=127.0.0.1
PORT=3032
STATUS_LOG_FILE=./status-history.json
MAX_HISTORY=1440
# Optional on a loopback HOST. Required for any other HOST.
# Client sends: Authorization: Bearer <STATUS_TOKEN>
STATUS_TOKEN=
